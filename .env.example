# EGX Shariah Engine — environment template.
# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- Supabase / Postgres ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://user:password@host:5432/postgres
SUPABASE_STORAGE_BUCKET=filings

# --- Anthropic (ingestion/extraction layer only) ---
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-4-8

# --- Runtime ---
# Persisted store backend for the repository layer: "memory" (default, no
# external deps) or "supabase" (requires the credentials above).
EGX_STORE_BACKEND=memory
LOG_LEVEL=INFO
