# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service_account*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.uv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# Archived filings / downloaded artefacts (kept out of git)
data/filings/
*.pdf
!tests/golden/**/*.pdf

# Personal financial data (decisions/0002): the LEDGER IS COMMITTED on purpose —
# it is the project's memory and git history is its audit trail. Only large
# binaries are excluded; their SHA-256 is recorded in the JSON that references
# them, so provenance survives even though the bytes do not.
memory/filings/**/*.pdf

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

.venv/
